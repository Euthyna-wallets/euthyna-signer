[Unit]
Description=Euthyna signer: holds agent keys outside the AI's reach
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=euthyna-signer
Group=euthyna
ExecStart=/usr/local/bin/euthyna-signer --config /etc/euthyna-signer/config.json serve
Restart=on-failure
RestartSec=2

RuntimeDirectory=euthyna-signer
RuntimeDirectoryMode=0750
StateDirectory=euthyna-signer
StateDirectoryMode=0700
LogsDirectory=euthyna-signer
LogsDirectoryMode=0750
UMask=0077

# Hardening: the signer only needs its own directories and outbound HTTPS.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
