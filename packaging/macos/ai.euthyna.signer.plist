<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.euthyna.signer</string>
  <key>UserName</key><string>_euthyna-signer</string>
  <key>GroupName</key><string>_euthyna</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/euthyna-signer</string>
    <string>--config</string>
    <string>/usr/local/etc/euthyna-signer/config.json</string>
    <string>serve</string>
  </array>
  <key>Umask</key><integer>63</integer>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/usr/local/var/log/euthyna-signer/daemon.log</string>
</dict>
</plist>
